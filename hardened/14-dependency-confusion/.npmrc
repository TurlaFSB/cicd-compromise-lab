# HARDENED .npmrc (lab fixture, scenario 14).
# Pins the @turla-lab scope to the internal registry, so those packages can
# only come from there — a public package of the same name is never consulted.
# Lifecycle scripts are disabled for every install.
@turla-lab:registry=https://npm.internal.turla-lab.example/
registry=https://registry.npmjs.org/
ignore-scripts=true
